// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  phone     String?
  avatarUrl String?
  avatarStoragePath String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  street    String
  city      String
  state     String
  zipCode   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Card {
  id        String    @id @default(uuid())
  userId    String
  holder    String
  last4     String
  brand     String?
  expMonth  Int
  expYear   Int
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Produto {
  id          String           @id
  slug        String           @unique
  name        String
  description String?
  img         String
  alt         String
  priceCents  Int
  stock       Int
  category    String
  catalogKey  String
  features    String[]
  promocao    String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variantes   ProdutoVariante[]
  images      ProdutoImagem[]

  @@index([category])
  @@index([catalogKey])
  @@map("Produtos")
}

model ProdutoImagem {
  id          String  @id @default(cuid())
  produtoId   String
  url         String
  alt         String
  position    Int     @default(0)
  storagePath String?
  produto     Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, position])
  @@map("ProdutoImagens")
}

model ProdutoVariante {
  id         String  @id
  produtoId  String
  name       String
  img        String
  alt        String
  priceCents Int
  stock      Int
  hex        String?
  corName    String?
  images     ProdutoVarianteImagem[]
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@map("ProdutoVariantes")
}

model ProdutoVarianteImagem {
  id          String          @id @default(cuid())
  varianteId  String
  url         String
  alt         String
  position    Int             @default(0)
  storagePath String?
  variante    ProdutoVariante @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  @@index([varianteId, position])
  @@map("ProdutoVarianteImagens")
}


model CartItem {
  id        String    @id @default(uuid())
  userId    String
  productId String
  variantId String
  quantity  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@unique([userId, productId, variantId])
  @@map("CartItems")
}


model Favorite {
  id         String   @id @default(uuid())
  userId     String
  productId  String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@unique([userId, productId])
  @@map("Favorites")
}
